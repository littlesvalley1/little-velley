{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "littles-valley-preparatory-school",
  "compatibility_date": "2026-10-18",
  "main": "src/worker.js",
  "d1_databases": [
    {
      "binding": "SCHOOL_DB",
      "database_name": "littles-valley-school",
      "database_id": "eb6b16a7-0f4c-4cfb-a630-d283e9d1c619",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCHOOL_MEDIA",
      "bucket_name": "littles-valley-school-media"
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  }
}
